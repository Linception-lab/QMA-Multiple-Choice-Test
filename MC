<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Multiple Choice Test</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="app-container">
    <header class="app-header">
      <span id="progress-text">Frage 1 von 10</span>
      <div class="progress-bar">
        <div class="progress-fill" id="progress-fill"></div>
      </div>
    </header>

    <main class="quiz-card">
      <h2 id="question-text" class="question">Wird hier die erste Frage angezeigt?</h2>
      
      <div class="options-container" id="options-container">
        <!-- Optionen werden dynamisch via JavaScript eingefügt -->
      </div>
    </main>

    <footer class="app-footer">
      <button id="next-btn" class="ios-btn" disabled onclick="nextQuestion()">Weiter</button>
    </footer>
  </div>

  <script src="script.js"></script>
</body>
</html>
